<Window x:Class="Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Settings"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}"/>

        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- toggle switch style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="46" Height="24" Cursor="Hand" Background="Transparent">
                                <Border x:Name="SwitchBackground" CornerRadius="12" 
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" 
                                        BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="SwitchBackgroundBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
                                    </Border.Background>
                                </Border>
                                <Ellipse x:Name="SwitchThumb" Width="18" Height="18" 
                                         Fill="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" 
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchThumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="22"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="SwitchBackground" Property="Background" Value="{StaticResource SystemControlHighlightAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBackground" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBackground" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchBackground" Property="BorderBrush" Value="{StaticResource SystemControlHighlightAccentBrush}"/>
                                <Setter TargetName="SwitchBackground" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="Settings Menu" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- jumpscare -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,24,16" VerticalAlignment="Top">
            <TextBlock Text="Selected jumpscare" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Choose character model" FontSize="12" 
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
            <ComboBox x:Name="JumpscareComboBox" Height="32" VerticalContentAlignment="Center"
                      AutomationProperties.Name="Selected Jumpscare Character"
                      SelectionChanged="JumpscareComboBox_SelectionChanged"/>
            <Border Margin="0,8,0,0" CornerRadius="8" 
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" 
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" 
                    BorderThickness="1" HorizontalAlignment="Left" Width="140" Height="100">
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry RadiusX="7" RadiusY="7" Rect="0,0,138,98"/>
                    </Grid.Clip>
                    <Image x:Name="CharacterPreviewImage" Stretch="UniformToFill" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="Character Visual Preview"/>
                    <TextBlock x:Name="PreviewPlaceholderText" Text="Preview Thumbnail" FontSize="11" 
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- freq -->
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,24,16" VerticalAlignment="Top">
            <TextBlock Text="Trigger Frequency" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="How often jumpscares trigger" FontSize="12" 
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
            <Slider x:Name="FrequencySlider" Minimum="1" Maximum="4" Value="2" 
                    TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    AutomationProperties.Name="Jumpscare Trigger Frequency"
                    ValueChanged="FrequencySlider_ValueChanged"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Rare" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="1" Text="Default" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Increased" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Frequent" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- autostart -->
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,24,16" VerticalAlignment="Top">
            <TextBlock Text="Autostart" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="Run automatically on system startup" FontSize="12" 
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,2,0,0"/>
        </StackPanel>
        <CheckBox x:Name="AutostartSwitch" Grid.Row="3" Grid.Column="1" 
                  Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,16"
                  AutomationProperties.Name="Autostart Background Service Switch"
                  Checked="AutostartSwitch_Checked" Unchecked="AutostartSwitch_Unchecked"/>

        <!-- test jumpscare -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right">
            <Button x:Name="TestJumpscareButton" Content="⚡ Test Jumpscare" Height="36" Padding="20,6" 
                    FontWeight="SemiBold" FontSize="14" Foreground="White" 
                    Background="{StaticResource SystemControlHighlightAccentBrush}" BorderThickness="0" 
                    Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}"
                    AutomationProperties.Name="Test Jumpscare Button"
                    Click="TestJumpscareButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
