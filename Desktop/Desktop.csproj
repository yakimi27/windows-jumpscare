<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>windowsJumpscare.ico</ApplicationIcon>
		<Product>Windows Jumpscare</Product>
		<AssemblyName>WindowsJumpscare</AssemblyName>
		<AssemblyTitle>Windows Jumpscare</AssemblyTitle>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
	</ItemGroup>

	<ItemGroup>

		<None Remove="Assets\**\*.png" />
		<Resource Include="Assets\**\*.png" />
		<Resource Include="windowsJumpscare.ico" />

		<Content Include="Assets\**\*.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\Icon\windowsJumpscare.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
